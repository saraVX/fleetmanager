<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FleetManager.ViewModels"
             x:Class="FleetManager.Views.MaintenancesView"
             x:DataType="vm:MaintenancesViewModel">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#FF9800" CornerRadius="8" Height="50" Margin="0,0,0,10">
            <Grid>
                <Button Content="← Retour" Command="{Binding GoBackCommand}" HorizontalAlignment="Left" Margin="10,0" Background="#555" Foreground="White" Width="80" VerticalAlignment="Center" CornerRadius="5"/>
                <TextBlock Text="GESTION DES ENTRETIENS" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Maintenances.Count} interventions" FontSize="11" Foreground="#FFE0B2" HorizontalAlignment="Right" Margin="0,0,15,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        
        <!-- Message info -->
        <Border Grid.Row="1" Background="#FFF3E0" CornerRadius="8" Margin="0,0,0,10" Padding="10">
            <TextBlock Text="Sélectionnez un entretien dans la liste pour le modifier ou le supprimer" Foreground="#E65100" FontSize="12"/>
        </Border>
        
        <!-- Liste des entretiens -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Maintenances}" SelectedItem="{Binding SelectedMaintenance}" Height="250" Margin="0,0,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="6" Margin="5" Padding="10" BorderBrush="#DDD" BorderThickness="1">
                        <StackPanel>
                            <TextBlock FontWeight="Bold" FontSize="14" Foreground="#FF9800">
                                <Run Text="{Binding Vehicle.Brand}"/> <Run Text="{Binding Vehicle.Model}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="#666">
                                <Run Text="Véhicule ID: {Binding VehicleId}"/> - <Run Text="{Binding MaintenanceDate, StringFormat='dd/MM/yyyy'}"/>
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="#666">
                                <Run Text="{Binding MaintenanceType}"/> - <Run Text="{Binding Cost} €"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="#666">
                                <Run Text="{Binding Description}"/> - <Run Text="{Binding Mechanic}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!-- Boutons -->
        <Border Grid.Row="3" Background="#F5F5F5" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15">
                <Button Content="Ajouter" Command="{Binding NewMaintenanceCommand}" Background="#4CAF50" Foreground="White" Width="100" Height="35"/>
                <Button Content="Modifier" Command="{Binding EditMaintenanceCommand}" Background="#FF9800" Foreground="White" Width="100" Height="35"/>
                <Button Content="Supprimer" Command="{Binding DeleteMaintenanceCommand}" Background="#F44336" Foreground="White" Width="100" Height="35"/>
                <Button Content="Annuler" Command="{Binding CancelEditCommand}" Background="#9E9E9E" Foreground="White" Width="100" Height="35" IsVisible="{Binding IsEditing}"/>
            </StackPanel>
        </Border>
        
        <!-- Formulaire -->
        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="15" IsVisible="{Binding IsEditing}" BorderBrush="#FF9800" BorderThickness="2">
            <StackPanel>
                <TextBlock Text="Formulaire entretien" FontSize="16" FontWeight="Bold" Foreground="#FF9800" Margin="0,0,0,15"/>
                
                <TextBox Watermark="ID Véhicule (1-4)" Text="{Binding FormVehicleId}" Margin="0,0,0,10" Height="35"/>
                <DatePicker SelectedDate="{Binding FormMaintenanceDate}" Margin="0,0,0,10" Height="35"/>
                <TextBox Watermark="Type d'entretien" Text="{Binding FormMaintenanceType}" Margin="0,0,0,10" Height="35"/>
                <TextBox Watermark="Description" Text="{Binding FormDescription}" Margin="0,0,0,10" Height="35"/>
                <TextBox Watermark="Coût (€)" Text="{Binding FormCost}" Margin="0,0,0,10" Height="35"/>
                <TextBox Watermark="Kilométrage" Text="{Binding FormMileageAtMaintenance}" Margin="0,0,0,10" Height="35"/>
                <TextBox Watermark="Garage" Text="{Binding FormMechanic}" Margin="0,0,0,15" Height="35"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15">
                    <Button Content="Enregistrer" Command="{Binding SaveMaintenanceCommand}" Background="#4CAF50" Foreground="White" Width="120" Height="35"/>
                    <Button Content="Annuler" Command="{Binding CancelEditCommand}" Background="#9E9E9E" Foreground="White" Width="120" Height="35"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

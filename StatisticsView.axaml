<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FleetManager.ViewModels"
             x:Class="FleetManager.Views.StatisticsView"
             x:DataType="vm:StatisticsViewModel">
    
    <ScrollViewer>
        <StackPanel Margin="10">
            
            <!-- Header -->
            <Border Background="#1A237E" CornerRadius="8" Height="50" Margin="0,0,0,10">
                <Grid>
                    <Button Content="← Retour" Command="{Binding GoBackCommand}" HorizontalAlignment="Left" Margin="10,0" Background="#555" Foreground="White" Width="80" VerticalAlignment="Center"/>
                    <TextBlock Text="STATISTIQUES DÉTAILLÉES" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            
            <!-- Section Véhicules -->
            <Border Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="🚗 PARC VEHICULES" FontSize="16" FontWeight="Bold" Foreground="#1A237E" Margin="0,0,0,15"/>
                    <Grid ColumnDefinitions="*,*,*">
                        <Border Background="White" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalVehicles}" FontSize="28" FontWeight="Bold" Foreground="#1A237E"/>
                                <TextBlock Text="Total véhicules" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding AvailableVehicles}" FontSize="28" FontWeight="Bold" Foreground="#4CAF50"/>
                                <TextBlock Text="Disponibles" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding MaintenanceVehicles}" FontSize="28" FontWeight="Bold" Foreground="#FF9800"/>
                                <TextBlock Text="En maintenance" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- Section Kilométrage -->
            <Border Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="📊 KILOMETRAGE" FontSize="16" FontWeight="Bold" Foreground="#1A237E" Margin="0,0,0,15"/>
                    <Grid ColumnDefinitions="*,*">
                        <Border Background="White" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalMileage}" FontSize="28" FontWeight="Bold" Foreground="#795548"/>
                                <TextBlock Text="Km totaux" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding AverageMileage}" FontSize="28" FontWeight="Bold" Foreground="#795548"/>
                                <TextBlock Text="Km moyen" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- Section Entretien -->
            <Border Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="🔧 ENTRETIEN" FontSize="16" FontWeight="Bold" Foreground="#FF9800" Margin="0,0,0,15"/>
                    <Grid ColumnDefinitions="*,*">
                        <Border Background="White" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalMaintenances}" FontSize="28" FontWeight="Bold" Foreground="#FF9800"/>
                                <TextBlock Text="Interventions" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalMaintenanceCost}" FontSize="28" FontWeight="Bold" Foreground="#F44336"/>
                                <TextBlock Text="Coût total (€)" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- Section Carburant -->
            <Border Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="⛽ CARBURANT" FontSize="16" FontWeight="Bold" Foreground="#4CAF50" Margin="0,0,0,15"/>
                    <Grid ColumnDefinitions="*,*,*">
                        <Border Background="White" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalFuelRecords}" FontSize="28" FontWeight="Bold" Foreground="#4CAF50"/>
                                <TextBlock Text="Pleins" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalFuelLiters}" FontSize="28" FontWeight="Bold" Foreground="#2196F3"/>
                                <TextBlock Text="Litres" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalFuelCost}" FontSize="28" FontWeight="Bold" Foreground="#F44336"/>
                                <TextBlock Text="Coût (€)" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
                        <Border Background="White" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding AverageFuelConsumption}" FontSize="28" FontWeight="Bold" Foreground="#9C27B0"/>
                                <TextBlock Text="L/100km" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- Section Assurances -->
            <Border Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="📋 ASSURANCES" FontSize="16" FontWeight="Bold" Foreground="#9C27B0" Margin="0,0,0,15"/>
                    <Grid ColumnDefinitions="*,*">
                        <Border Background="White" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalInsurances}" FontSize="28" FontWeight="Bold" Foreground="#9C27B0"/>
                                <TextBlock Text="Contrats" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalInsuranceCost}" FontSize="28" FontWeight="Bold" Foreground="#F44336"/>
                                <TextBlock Text="Coût total (€)" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- Section Conducteurs -->
            <Border Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="👥 CONDUCTEURS" FontSize="16" FontWeight="Bold" Foreground="#607D8B" Margin="0,0,0,15"/>
                    <Grid ColumnDefinitions="*,*">
                        <Border Background="White" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding TotalDrivers}" FontSize="28" FontWeight="Bold" Foreground="#607D8B"/>
                                <TextBlock Text="Conducteurs" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="8" Margin="5" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding UpcomingMaintenances}" FontSize="28" FontWeight="Bold" Foreground="#00BCD4"/>
                                <TextBlock Text="Entretiens à venir" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
